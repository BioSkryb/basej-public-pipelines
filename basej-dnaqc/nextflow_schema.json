{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://github.com/BioSkryb/basej-public-pipelines/basej-dnaqc/nextflow_schema.json",
    "title": "basej-dnaqc pipeline parameters",
    "description": "Single-pass Rust single-cell DNA QC (rewrites.bio rewrite of basej-dnaqc): seqkit subsample + fastp + minibwa + dupblaster + bskryb-qc. x86, no Sentieon license.",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Where the pipeline finds input data and saves output data.",
            "required": [
                "input_csv",
                "outputDir",
                "workspace",
                "dataset_id"
            ],
            "properties": {
                "input_csv": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "CSV, one row per biosample. Illumina/Element: biosampleName (or biosample), read1, read2 (read1/read2 may be pipe-delimited multi-lane). Ultima: biosampleName, cram[, crai] (pre-aligned CRAM; crai defaults to <cram>.crai). Any row with a cram value makes the whole run Ultima.",
                    "fa_icon": "fas fa-file-csv"
                },
                "workspace": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Workspace identifier for S3 output layout and tagging."
                },
                "dataset_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dataset identifier for S3 tagging and organization."
                },
                "outputDir": {
                    "type": "string",
                    "description": "Output directory (S3 path).",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "reference_genome_options": {
            "title": "Reference genome options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference genome and index files (auto-populated from genomes.config).",
            "properties": {
                "genome": {
                    "type": "string",
                    "default": "GRCh38",
                    "description": "Reference genome key from conf/genomes.config."
                },
                "minibwa_index": {
                    "type": "string",
                    "description": "minibwa index prefix (.mbw + .l2b), built once with minibwa-rs index."
                },
                "intervals": {
                    "type": "string",
                    "description": "Base metrics intervals (BED or Picard interval_list)."
                },
                "genome_territory": {
                    "type": "integer",
                    "description": "Non-N reference bases (GENOME_TERRITORY) for the coverage block. GRCh38 ~= 2923732648."
                },
                "reference_fasta": {
                    "type": "string",
                    "description": "Reference FASTA (only when run_gcbias=true)."
                },
                "gc_windows_index": {
                    "type": "string",
                    "description": "Precomputed windowsByGc index (optional)."
                }
            }
        },
        "read_processing_options": {
            "title": "Read processing options",
            "type": "object",
            "fa_icon": "fas fa-cut",
            "properties": {
                "n_reads": {
                    "type": "integer",
                    "default": 2000000,
                    "description": "Subsample target reads for QC."
                },
                "seqkit_sample_seed": {
                    "type": "integer",
                    "default": 12345,
                    "description": "Deterministic seqkit subsampling seed."
                },
                "samtools_seed": {
                    "type": "integer",
                    "default": 12345,
                    "description": "Deterministic samtools subsampling seed for Ultima CRAM input."
                },
                "run_gcbias": {
                    "type": "boolean",
                    "default": true,
                    "description": "Emit GC-bias metrics (stages the reference FASTA). Enabled by default for parity with basej-dnaqc."
                }
            }
        },
        "sequencing_options": {
            "title": "Sequencing options",
            "type": "object",
            "fa_icon": "fas fa-microchip",
            "properties": {
                "platform": {
                    "type": "string",
                    "default": "ILLUMINA",
                    "description": "Sequencing platform (read-group PL)."
                },
                "architecture": {
                    "type": "string",
                    "default": "x86",
                    "enum": [
                        "x86"
                    ],
                    "description": "CPU architecture of the container images. The public release is x86_64 only."
                }
            }
        },
        "resource_label_options": {
            "title": "Resource label options",
            "type": "object",
            "fa_icon": "fas fa-tags",
            "properties": {
                "pipeline_user": {
                    "type": "string",
                    "default": "basejumper",
                    "description": "User label for AWS cost tagging."
                },
                "biosample_count": {
                    "type": "string",
                    "default": "0",
                    "description": "Biosample count label."
                },
                "basejumper_organization_uuid": {
                    "type": "string",
                    "description": "Organization UUID label."
                },
                "basejumper_organization_name": {
                    "type": "string",
                    "description": "Organization name label."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/reference_genome_options"
        },
        {
            "$ref": "#/definitions/read_processing_options"
        },
        {
            "$ref": "#/definitions/sequencing_options"
        },
        {
            "$ref": "#/definitions/resource_label_options"
        }
    ]
}
