nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    // chr22-only test reference bundle (minibwa index, GC windows, Ginkgo 1Mb/50bp refs).
    // NFTEST_GENOMES_BASE points the tests at a local copy of the same bundle for development.
    def genomesBase = System.getenv("NFTEST_GENOMES_BASE") ?: "s3://bioskryb-public-data/pipeline_resources/test_genomes"

    test("dna_qc_GRCh38_test") {
        tag "GRCh38"
        when {
            params {
                outputDir    = "${outputDir}"
                workspace    = "demo"
                workflow_id  = "test_GRCh38"
                input_csv    = "$baseDir/tests/data/inputs/nftest_input.csv"
                genomes_base = genomesBase
                max_memory   = "12.GB"
                max_cpus     = "4"
                architecture = "x86"
                genome       = "GRCh38"
                n_reads      = 500000
                // On a chr22-only reference Ginkgo has too few segments to measure CNV skew
                // (NA for every cell), which the DNA QC scoring correctly refuses to score.
                // CNV + QC plots are therefore exercised by full-genome runs, not this CI test.
                skip_cnv     = true
            }
        }

        then {
            def wf = "${outputDir}/workflow_outputs/demo/test_GRCh38"
            assertAll(
                { assert workflow.success },
                { assert path("${wf}/reports/multiqc_report.html").exists() },
                { assert path("${wf}/execution_info/tool_mqc_versions.yml").exists() },
                { assert path("${wf}/index/bam.csv").exists() },
                { assert path("${wf}/index/per_biosample_status.csv").readLines().size() == 3 },

                {
                    def f = path("${wf}/metrics/qc_metrics/dnaqc_all_metrics.tsv")
                    assert f.exists()
                    def lines  = f.readLines()
                    def header = lines[0].split('\t').toList()
                    ['qc_score', 'qc_status', 'pct_chrm', 'align_pct_chimeras', 'preseq_count',
                     'total_reads', 'final_reads', 'subsampled', 'insert_size', 'fastp_q30_rate',
                     'gc_gc_nc_40_59', 'insert_min', 'insert_max', 'insert_median_absolute_deviation'].each { col ->
                        assert header.contains(col) : "Missing column: ${col}"
                    }
                    def idx = { col -> header.indexOf(col) }
                    def dbl = { v -> (v && v != 'NA' && v != 'None' && !v.isEmpty()) ? v.toDouble() : null }

                    // Read counts are pre-alignment and deterministic (seeded subsampling).
                    def expected = [
                        'chr22_testsample1': [total_reads: 4132446, final_reads: 498686],
                        'chr22_testsample2': [total_reads: 4132446, final_reads: 498686],
                    ]
                    assert lines.size() - 1 == expected.size()
                    for (int i = 1; i < lines.size(); i++) {
                        def c = lines[i].split('\t', -1)
                        def s = c[idx('biosample')]
                        def exp = expected[s]
                        assert exp != null : "Unexpected sample: ${s}"
                        assert c[idx('total_reads')].toLong() == exp.total_reads : "total_reads ${s}"
                        assert c[idx('final_reads')].toLong() == exp.final_reads : "final_reads ${s}"
                        assert c[idx('subsampled')] == 'True'
                        // CNV skipped -> required CNV metrics missing -> FAIL (score 2, unmeasured)
                        assert c[idx('qc_status')] == 'FAIL' : "qc_status ${s}"
                        def v
                        v = dbl(c[idx('pct_chrm')]);           assert v >= 0    && v <= 0.05 : "pct_chrm ${s}: ${v}"
                        v = dbl(c[idx('align_pct_chimeras')]); assert v > 0.02  && v < 0.2   : "chimeras ${s}: ${v}"
                        v = dbl(c[idx('preseq_count')]);       assert v > 1e6               : "preseq_count ${s}: ${v}"
                        v = dbl(c[idx('insert_size')]);        assert v > 100   && v < 600   : "insert_size ${s}: ${v}"
                        v = dbl(c[idx('fastp_q30_rate')]);     assert v > 0.7   && v <= 1.0  : "q30 ${s}: ${v}"
                        v = dbl(c[idx('gc_gc_nc_40_59')]);     assert v > 0.5   && v < 1.5   : "gc_nc_40_59 ${s}: ${v}"
                    }
                },

                {
                    ['chr22_testsample1', 'chr22_testsample2'].each { s ->
                        assert path("${outputDir}/tables/dnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=${s}/output.parquet").exists()
                    }
                }
            )
        }
    }
}
