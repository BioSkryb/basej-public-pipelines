// ============================================================================
// BASEJ-DNAQC PIPELINE CONFIGURATION
// ============================================================================

manifest {
    name            = "basej-dnaqc"
    description     = "Single-cell DNA QC: subsample, align (minibwa-rs), mark duplicates, single-pass Rust QC metrics, preseq complexity and Ginkgo CNV QC"
    homePage        = "https://github.com/BioSkryb/basej-public-pipelines"
    mainScript      = "main.nf"
    version         = "2.0.0"
}

nextflow.enable.dsl=2
nextflow.enable.configProcessNamesValidation = false

// ============================================================================
// LOAD SHARED CONFIGURATIONS
// ============================================================================
includeConfig './conf/genomes.config'
includeConfig './conf/environment.config'

// ============================================================================
// DEFAULT PARAMETERS
// ============================================================================
params {
    resume_workflow_id = null
    workflow_id     = params.resume_workflow_id ?: System.getenv("TOWER_WORKFLOW_ID") ?: "TEST_WORKFLOW_ID"
    biosample_count = "0"
    workspace       = "basej-dnaqc"
    dataset_id      = "test_dataset"
    pipeline_user   = "basejumper"
    pipeline_version = null   // defaults to manifest.version in main.nf

    input_csv       = ""
    outputDir       = "results"

    genome          = "GRCh38"
    architecture    = "x86"
    platform        = "ILLUMINA"

    n_reads             = 2000000   // subsample target for QC
    seqkit_sample_seed  = 12345
    samtools_seed       = 12345     // Ultima CRAM subsampling (samtools view -s)
    read_length         = 50        // Ginkgo reference selection

    minibwa_index   = params.genomes[params.genome]['minibwa_index']

    intervals       = params.genomes[params.genome]['base_metrics_intervals']

    genome_territory = null

    run_gcbias      = true
    reference_fasta = "${params.genomes[params.genome]['reference']}/genome.fa"
    gc_windows_index = params.genomes[params.genome]['gc_windows_base_metrics']

    skip_cnv      = null       // null => auto-skip for pUC19
    bin_size      = 1000000
    min_ploidy    = 1.5
    max_ploidy    = 6
    min_bin_width = 5
    is_haplotype  = 2
    ginko_ref_dir = (params.genome in ["GRCh38", "GRCm39", "ARSUCD2"])
        ? params.genomes[params.genome]["${params.bin_size}"]["${params.read_length}"]['ginko_ref_dir']
        : ""

    basejumper_organization_uuid = ""
    basejumper_organization_name = ""
}

outputDir = params.outputDir


// ============================================================================
// PROCESS CONFIGURATION
// ============================================================================
process {


    withName: 'MERGE_MULTILANE_FASTQ' {
        container = 'basejumper_seqkit-2.13.0'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 2
        memory    = 6.GB
        time      = 4.h
    }

    withName: 'SEQKIT_SAMPLE' {
        container = 'basejumper_seqkit-2.13.0'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 4
        memory    = 7.GB
        time      = { 8.h * task.attempt }
    }

    withName: 'SAMTOOLS_SUBSAMPLE_CRAM' {
        container = 'basejumper_samtools-1.23.1'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 2
        memory    = 7.GB
        time      = 10.h
    }

    withName: 'CRAM_DEDUP' {
        container = 'basejumper_minibwa-rustqc_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 4
        memory    = 7.GB
        time      = 3.h
    }

    withName: 'FASTP_TRIM' {
        container = 'quay.io/biocontainers/fastp:0.20.1--h8b12597_0'
        cpus      = { task.attempt <= 1 ? 2 : 4 }
        memory    = { task.attempt <= 1 ? 7.GB : 14.GB }
        time      = 2.h
    }

    withName: 'ALIGN_DEDUP' {
        container = 'basejumper_minibwa-rustqc_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 4
        memory    = { task.attempt <= 1 ? 14.GB : 28.GB }
        time      = 3.h
    }

    withName: 'GCBIAS_INDEX' {
        container = 'basejumper_bskryb-rustqc-x86_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 2
        memory    = 6.GB
        time      = 1.h
    }

    withName: 'RUSTQC_METRICS' {
        container = 'basejumper_bskryb-rustqc-x86_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 4
        memory    = 7.GB
        time      = 1.h
    }

    withName: 'PRESEQ' {
        container      = 'basejumper_preseq_bam2mr_0.1'
        cpus           = 1
        memory         = '3 GB'
        time           = 2.h
    }

    withName: 'GINKGO_CNV_SUMMARY' {
        container      = 'basejumper_custom_r_qcplots_0.3.0'
        cpus           = 2
        memory         = '7 GB'
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries     = 2
        time           = 2.h
    }

    withName: 'QC_PLOTS' {
        container      = 'basejumper_custom_r_qcplots_0.3.0'
        cpus           = 2
        memory         = '7 GB'
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries     = 2
        time           = 1.h
    }

    withName: 'BAM_TO_BED' {
        container      = "quay.io/biocontainers/bedtools:2.28.0--hdf88d34_0"
        cpus           = 1
        memory         = 3.GB
        time           = { 2.h * task.attempt }
    }
    withName: 'GINKGO_BINUNSORT' {
        container      = "basejumper_ginkgo_0.3.1"
        cpus           = 1
        memory         = 3.GB
        time           = 1.h
    }
    withName: 'GINKGO_SEGMENTATION_R' {
        container      = "basejumper_ginkgo_0.3.1"
        cpus           = 1
        memory         = 3.GB
        time           = 1.h
    }
    withName: 'GINKGO_CNV_CALLER' {
        container      = "basejumper_ginkgo_0.3.1"
        cpus           = 1
        memory         = 3.GB
        time           = 1.h
    }
    withName: 'GINKO_RDS_TO_FLAT' {
        container      = "basejumper_ginkgo_0.3.1"
        cpus           = 1
        memory         = 3.GB
        time           = 1.h
    }
    withName: 'GINKO_PARSE_OUTPUTS' {
        container      = "basejumper_ginko_parser_0.2.1"
        cpus           = 2
        memory         = 7.GB
        time           = 1.h
    }
    withName: 'PARSE_RDS_CNV_METRICS' {
        container      = "basejumper_ginkgo_0.3.1"
        errorStrategy  = 'ignore'
        cpus           = 2
        memory         = 7.GB
        time           = 1.h
    }

    withName: 'GINKGO_BINS_TO_PARQUET' {
        container      = 'basejumper_custom_parabricks-metrics_1.0.3'
        cpus           = 2
        memory         = '8 GB'
        time           = 30.m
    }

    withName: 'METRICS_TO_PARQUET' {
        container = 'basejumper_custom_parabricks-metrics_1.0.3'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 2
        memory    = 6.GB
        time      = 30.m
    }

    withName: 'MULTIQC' {
        container      = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
        cpus           = 2
        memory         = '7 GB'
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        time           = 5.h
    }
}

// ============================================================================
// LOAD REPORTING CONFIGURATION
// ============================================================================
includeConfig './conf/reporting.config'
