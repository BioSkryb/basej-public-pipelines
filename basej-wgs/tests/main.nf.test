nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    // chr22-only test reference bundle (minibwa index, GC windows, chr22 IDT panel subset).
    // NFTEST_GENOMES_BASE points the tests at a local copy of the same bundle for development.
    def genomesBase = System.getenv("NFTEST_GENOMES_BASE") ?: "s3://bioskryb-public-data/pipeline_resources/test_genomes"
    // Non-N bases in the chr22 wgs_coverage_regions interval (full GRCh38 value: 2745186691).
    def chr22Territory = 37071985

    test("wgsqc_GRCh38_test") {
        tag "GRCh38"
        when {
            params {
                outputDir        = "${outputDir}"
                workspace        = "demo"
                workflow_id      = "test_wgs_GRCh38"
                input_csv        = "$baseDir/tests/data/inputs/nftest_input.csv"
                genomes_base     = genomesBase
                genome_territory = chr22Territory
                max_memory       = "12.GB"
                max_cpus         = "4"
                architecture     = "x86"
                genome           = "GRCh38"
                mode             = "wgs"
                skip_subsampling = true
            }
        }

        then {
            def wf = "${outputDir}/workflow_outputs/demo/test_wgs_GRCh38"
            assertAll(
                { assert workflow.success },
                { assert path("${wf}/reports/multiqc_report.html").exists() },
                { assert path("${wf}/qc_plots/qc_wgs.pdf").exists() },
                { assert path("${wf}/qc_plots/WGS-QC_composition_mqc.jpg").exists() },
                { assert path("${wf}/metrics/wgsqc_metrics/WGS-QC_ConsensusScores.txt").exists() },
                { assert path("${wf}/index/bam.csv").exists() },
                { assert path("${wf}/index/per_biosample_status.csv").readLines().size() == 3 },

                // Python verdict (Parquet) and R consensus score must agree for every sample
                {
                    def rows = path("${wf}/qc_plots/qc_score_concordance.tsv").readLines().drop(1)
                    assert rows.size() == 2
                    rows.each { r -> assert r.split('\t')[-1] == 'match' : "QC score mismatch: ${r}" }
                },

                {
                    def f = path("${wf}/metrics/wgsqc_metrics/wgsqc_all_metrics.tsv")
                    assert f.exists()
                    def lines  = f.readLines()
                    def header = lines[0].split('\t').toList()
                    [
                        'qc_score', 'qc_status', 'total_reads', 'total_reads_source', 'pct_duplication',
                        'mean_coverage', 'pct_chimeras', 'pf_hq_error_rate', 'insert_median',
                        'gc_nc_40_59', 'median_coverage', 'pct_1x', 'pct_5x', 'pct_10x', 'pct_exc_total',
                    ].each { col -> assert header.contains(col) : "Missing column: ${col}" }
                    def idx = { col -> header.indexOf(col) }
                    def dbl = { v -> (v && v != 'NA' && !v.isEmpty()) ? v.toDouble() : null }

                    // chr22-only reference: reads from the whole genome are forced onto chr22, so
                    // coverage/chimera values differ from a full-genome run.
                    def expected = [
                        'ResolveOMEv2.0-384-WGS-B4': 2000390,
                        'ResolveOMEv2.0-384-WGS-D3': 1999522,
                    ]
                    assert lines.size() - 1 == expected.size()
                    for (int i = 1; i < lines.size(); i++) {
                        def c = lines[i].split('\t', -1)
                        def s = c[idx('biosample')]
                        assert expected.containsKey(s) : "Unexpected sample: ${s}"
                        // raw input reads (deterministic: no subsampling)
                        assert c[idx('total_reads')].toLong() == expected[s] : "total_reads ${s}"
                        assert c[idx('total_reads_source')] == 'raw_input'
                        assert c[idx('qc_status')] == 'FAIL' && c[idx('qc_score')].toDouble().intValue() == 2 : "qc ${s}"
                        def v
                        v = dbl(c[idx('mean_coverage')]);   assert v > 0.2  && v < 0.8  : "mean_coverage ${s}: ${v}"
                        v = dbl(c[idx('pct_1x')]);          assert v > 0.05 && v < 0.3  : "pct_1x ${s}: ${v}"
                        v = dbl(c[idx('pct_5x')]);          assert v >= 0   && v < 0.05 : "pct_5x ${s}: ${v}"
                        v = dbl(c[idx('pct_duplication')]); assert v >= 0   && v < 0.10 : "pct_duplication ${s}: ${v}"
                        v = dbl(c[idx('pct_chimeras')]);    assert v > 0.2  && v < 0.6  : "pct_chimeras ${s}: ${v}"
                        v = dbl(c[idx('insert_median')]);   assert v > 150  && v < 400  : "insert_median ${s}: ${v}"
                        v = dbl(c[idx('gc_nc_40_59')]);     assert v > 0.5  && v < 1.5  : "gc_nc_40_59 ${s}: ${v}"
                    }
                },

                {
                    ['ResolveOMEv2.0-384-WGS-B4', 'ResolveOMEv2.0-384-WGS-D3'].each { s ->
                        assert path("${outputDir}/tables/wgsqc_summary/workspace=demo/workflow_id=test_wgs_GRCh38/biosample=${s}/output.parquet").exists()
                    }
                }
            )
        }
    }

    test("wesqc_GRCh38_test") {
        tag "GRCh38"
        when {
            params {
                outputDir        = "${outputDir}"
                workspace        = "demo"
                workflow_id      = "test_wes_GRCh38"
                input_csv        = "$baseDir/tests/data/inputs/nftest_input_exome.csv"
                genomes_base     = genomesBase
                max_memory       = "12.GB"
                max_cpus         = "4"
                architecture     = "x86"
                genome           = "GRCh38"
                mode             = "exome"
                exome_panel      = "xGen Exome Hyb Panel v2"
                skip_subsampling = true
            }
        }

        then {
            def wf = "${outputDir}/workflow_outputs/demo/test_wes_GRCh38"
            assertAll(
                { assert workflow.success },
                { assert path("${wf}/reports/multiqc_report.html").exists() },
                { assert path("${wf}/qc_plots/qc_wes.pdf").exists() },
                { assert path("${wf}/qc_plots/WES-QC_composition_mqc.jpg").exists() },
                { assert path("${wf}/metrics/wesqc_metrics/WES-QC_ConsensusScores.txt").exists() },
                { assert path("${wf}/index/bam.csv").exists() },
                {
                    def rows = path("${wf}/qc_plots/qc_score_concordance.tsv").readLines().drop(1)
                    assert rows.size() == 2
                    rows.each { r -> assert r.split('\t')[-1] == 'match' : "QC score mismatch: ${r}" }
                },
                {
                    def f = path("${wf}/metrics/wesqc_metrics/wesqc_all_metrics.tsv")
                    assert f.exists()
                    def lines  = f.readLines()
                    def header = lines[0].split('\t').toList()
                    def idx = { col -> header.indexOf(col) }
                    def dbl = { v -> (v && v != 'NA' && !v.isEmpty()) ? v.toDouble() : null }
                    def expected = [
                        'ResolveOME-Exome-IDTxGenV2-96Plex-4Hr-01H-SC': 2003300,
                        'ResolveOME-Exome-IDTxGenV2-96Plex-4Hr-02B-SC': 2000368,
                    ]
                    assert lines.size() - 1 == expected.size()
                    for (int i = 1; i < lines.size(); i++) {
                        def c = lines[i].split('\t', -1)
                        def s = c[idx('biosample')]
                        assert expected.containsKey(s) : "Unexpected sample: ${s}"
                        assert c[idx('total_reads')].toLong() == expected[s] : "total_reads ${s}"
                        assert c[idx('qc_status')] == 'FAIL' && c[idx('qc_score')].toDouble().intValue() == 1 : "qc ${s}"
                        // WGS coverage block is null in exome mode; target metrics come from HsMetrics
                        assert dbl(c[idx('mean_coverage')]) == null : "mean_coverage must be null in exome mode"
                        def v
                        v = dbl(c[idx('mean_target_coverage')]); assert v > 1.0  && v < 6.0  : "mean_target_coverage ${s}: ${v}"
                        v = dbl(c[idx('pct_target_bases_10x')]); assert v >= 0   && v < 0.2  : "pct_target_bases_10x ${s}: ${v}"
                        v = dbl(c[idx('zero_cvg_targets_pct')]); assert v > 0.02 && v < 0.3  : "zero_cvg_targets_pct ${s}: ${v}"
                        v = dbl(c[idx('fold_enrichment')]);      assert v > 5    && v < 60   : "fold_enrichment ${s}: ${v}"
                        v = dbl(c[idx('pct_duplication')]);      assert v >= 0   && v < 0.10 : "pct_duplication ${s}: ${v}"
                        v = dbl(c[idx('insert_median')]);        assert v > 100  && v < 300  : "insert_median ${s}: ${v}"
                    }
                },
                {
                    ['ResolveOME-Exome-IDTxGenV2-96Plex-4Hr-01H-SC', 'ResolveOME-Exome-IDTxGenV2-96Plex-4Hr-02B-SC'].each { s ->
                        assert path("${outputDir}/tables/wesqc_summary/workspace=demo/workflow_id=test_wes_GRCh38/biosample=${s}/output.parquet").exists()
                    }
                }
            )
        }
    }
}
