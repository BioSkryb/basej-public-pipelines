{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://github.com/BioSkryb/basej-public-pipelines/basej-wgs/nextflow_schema.json",
    "title": "basej-wgsqc pipeline parameters",
    "description": "Single-pass Rust WGS QC (rewrites.bio rewrite of the basej-wgs FASTQ path): minibwa + dupblaster + bskryb-qc. ARM/NEON or x86/SSE, no Sentieon license.",
    "type": "object",
    "additionalProperties": true,
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Where the pipeline finds input data and saves output data.",
            "required": [
                "input_csv",
                "outputDir",
                "workspace",
                "dataset_id"
            ],
            "properties": {
                "input_csv": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "CSV, one row per biosample. FASTQ rows: biosampleName (or biosample), read1, read2 (read1/read2 may be pipe-delimited multi-lane). Ultima rows: biosampleName, cram[, crai] (pre-aligned, duplicate-marked CRAM; crai defaults to <cram>.crai). Rows are routed by content, so a run may mix both.",
                    "fa_icon": "fas fa-file-csv"
                },
                "workspace": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Workspace identifier for S3 output layout and tagging."
                },
                "dataset_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dataset identifier for S3 tagging and organization."
                },
                "outputDir": {
                    "type": "string",
                    "description": "Output directory (S3 path).",
                    "fa_icon": "fas fa-folder-open"
                },
                "publish_bam": {
                    "type": "boolean",
                    "default": true,
                    "description": "Retain and publish the coordinate-sorted BAM and BAI for each biosample (index/bam.csv). Enabled by default: downstream variant-calling pipelines consume these BAMs. Full-depth WGS BAMs are commonly 40-55 GB each; set false to skip the S3 output cost."
                }
            }
        },
        "reference_genome_options": {
            "title": "Reference genome options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference genome and interval/index files (auto-populated from genomes.config).",
            "properties": {
                "genome": {
                    "type": "string",
                    "default": "GRCh38",
                    "description": "Reference genome key from conf/genomes.config."
                },
                "minibwa_index": {
                    "type": "string",
                    "description": "minibwa index prefix (.mbw + .l2b), built once with minibwa-rs index."
                },
                "intervals": {
                    "type": "string",
                    "description": "Base metrics intervals (BED or Picard interval_list)."
                },
                "wgs_or_target_intervals": {
                    "type": "string",
                    "description": "WGS coverage regions (interval_list) for WgsMetrics-style coverage."
                },
                "coverage_intervals": {
                    "type": "string",
                    "description": "Interval set scoping ONLY the WgsMetrics-style coverage block (defaults to wgs_or_target_intervals). Must be a subset of intervals, which scopes AlignmentStat/GcBias/InsertSize; bskryb-qc aborts otherwise."
                },
                "genome_territory": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 2745186691,
                    "description": "Non-N territory represented by the configured WGS coverage intervals. GRCh38 wgs_coverage_regions = 2745186691."
                },
                "reference_fasta": {
                    "type": "string",
                    "description": "Reference FASTA (only when run_gcbias=true)."
                },
                "gc_windows_index": {
                    "type": "string",
                    "description": "Precomputed windowsByGc index (optional)."
                }
            }
        },
        "pipeline_mode_options": {
            "title": "Pipeline mode options",
            "type": "object",
            "fa_icon": "fas fa-sliders-h",
            "properties": {
                "mode": {
                    "type": "string",
                    "default": "wgs",
                    "enum": [
                        "wgs",
                        "exome"
                    ],
                    "description": "QC mode. wgs: WGS coverage metrics (wgsqc_* outputs). exome: target-capture metrics via Picard CollectHsMetrics over the exome_panel targets (wesqc_* outputs)."
                },
                "exome_panel": {
                    "type": "string",
                    "default": "xGen Exome Hyb Panel v2",
                    "enum": [
                        "xGen Exome Hyb Panel v2",
                        "TruSight One",
                        "TWIST",
                        "Agilent Clinical Exome",
                        "Twist Exome 2.0",
                        "xGen Pan-Cancer Hybridization Panel",
                        "Twist Alliance CNTG Hereditary Oncology Panel"
                    ],
                    "description": "Capture panel (mode=exome); targets come from genomes[genome][exome_panel].wgs_or_target_intervals."
                },
                "target_intervals": {
                    "type": "string",
                    "description": "Optional target interval_list overriding the exome_panel lookup (mode=exome)."
                },
                "run_gcbias": {
                    "type": "boolean",
                    "default": true,
                    "description": "Emit GC-bias metrics (stages the reference FASTA). Enabled by default for Sentieon parity."
                }
            }
        },
        "read_processing_options": {
            "title": "Read processing options",
            "type": "object",
            "fa_icon": "fas fa-cut",
            "properties": {
                "skip_subsampling": {
                    "type": "boolean",
                    "default": true,
                    "description": "Skip subsampling (WGS QC runs on full data by default)."
                },
                "max_total_reads": {
                    "type": "integer",
                    "default": 1000000000,
                    "description": "Subsample target when skip_subsampling=false."
                },
                "seqkit_sample_seed": {
                    "type": "integer",
                    "default": 12345,
                    "description": "Deterministic seqkit subsampling seed."
                },
                "samtools_seed": {
                    "type": "integer",
                    "default": 12345,
                    "description": "Deterministic samtools subsampling seed for Ultima CRAM input (only when skip_subsampling=false)."
                }
            }
        },
        "sequencing_options": {
            "title": "Sequencing options",
            "type": "object",
            "fa_icon": "fas fa-microchip",
            "properties": {
                "platform": {
                    "type": "string",
                    "default": "ILLUMINA",
                    "description": "Sequencing platform (read-group PL)."
                },
                "architecture": {
                    "type": "string",
                    "default": "x86",
                    "enum": [
                        "x86"
                    ],
                    "description": "CPU architecture of the container images. The public release is x86_64 only."
                }
            }
        },
        "resource_label_options": {
            "title": "Resource label options",
            "type": "object",
            "fa_icon": "fas fa-tags",
            "properties": {
                "pipeline_user": {
                    "type": "string",
                    "default": "basejumper",
                    "description": "User label for AWS cost tagging."
                },
                "biosample_count": {
                    "type": "string",
                    "default": "0",
                    "description": "Biosample count label."
                },
                "basejumper_organization_uuid": {
                    "type": "string",
                    "description": "Organization UUID label."
                },
                "basejumper_organization_name": {
                    "type": "string",
                    "description": "Organization name label."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/reference_genome_options"
        },
        {
            "$ref": "#/definitions/pipeline_mode_options"
        },
        {
            "$ref": "#/definitions/read_processing_options"
        },
        {
            "$ref": "#/definitions/sequencing_options"
        },
        {
            "$ref": "#/definitions/resource_label_options"
        }
    ]
}
