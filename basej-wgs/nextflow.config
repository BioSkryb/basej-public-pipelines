// ============================================================================
// BASEJ-WGSQC PIPELINE CONFIGURATION
// ============================================================================

manifest {
    name            = "basej-wgsqc"
    description     = "Whole-genome / exome DNA QC: align (minibwa-rs), mark duplicates, coordinate-sort and single-pass Rust QC metrics, with Picard HsMetrics in exome mode"
    homePage        = "https://github.com/BioSkryb/basej-public-pipelines"
    mainScript      = "main.nf"
    version         = "2.0.0"
}

nextflow.enable.dsl=2
nextflow.enable.configProcessNamesValidation = false

// ============================================================================
// LOAD SHARED CONFIGURATIONS
// ============================================================================
includeConfig './conf/genomes.config'
includeConfig './conf/environment.config'

// ============================================================================
// DEFAULT PARAMETERS
// ============================================================================
params {
    resume_workflow_id = null
    workflow_id     = params.resume_workflow_id ?: System.getenv("TOWER_WORKFLOW_ID") ?: "TEST_WORKFLOW_ID"
    biosample_count = "0"
    workspace       = "basej-wgsqc"
    dataset_id      = "test_dataset"
    pipeline_user   = "basejumper"
    pipeline_version = null   // defaults to manifest.version in main.nf

    input_csv       = ""
    outputDir       = "results"
    publish_bam     = true

    genome          = "GRCh38"
    architecture    = "x86"
    platform        = "ILLUMINA"
    mode            = "wgs"       // wgs or exome
    exome_panel      = "xGen Exome Hyb Panel v2"
    target_intervals = null

    skip_subsampling   = true
    max_total_reads    = 1000000000
    seqkit_sample_seed = 12345
    samtools_seed      = 12345     // Ultima CRAM subsampling (samtools view -s), only if !skip_subsampling

    minibwa_index   = params.genomes[params.genome]['minibwa_index']

    intervals               = params.genomes[params.genome]['base_metrics_intervals']
    wgs_or_target_intervals = params.genomes[params.genome]['wgs_or_target_intervals']
    coverage_intervals      = params.genomes[params.genome]['wgs_or_target_intervals']

    genome_territory = params.genomes[params.genome]['genome_territory']

    run_gcbias      = true
    reference_fasta = "${params.genomes[params.genome]['reference']}/genome.fa"
    gc_windows_index = params.genomes[params.genome]['gc_windows_base_metrics']

    basejumper_organization_uuid = ""
    basejumper_organization_name = ""
}

outputDir = params.outputDir


// ============================================================================
// PROCESS CONFIGURATION
// ============================================================================
process {

    withName: 'MERGE_MULTILANE_FASTQ' {
        container = 'basejumper_seqkit-2.13.0'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 2
        memory    = 6.GB
        time      = 4.h
    }

    withName: 'SEQKIT_SAMPLE' {
        container = 'basejumper_seqkit-2.13.0'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 4
        memory    = 7.GB
        time      = 6.h
    }

    withName: 'ALIGN_DEDUP_QC' {
        container = 'basejumper_minibwa-rustqc_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = { params.mode == 'exome' ? 16 : 62 }
        memory    = { params.mode == 'exome'
            ? 60.GB
            : 240.GB }
        time      = 8.h
    }

    withName: 'SAMTOOLS_SUBSAMPLE_CRAM' {
        container = 'basejumper_samtools-1.23.1'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        cpus      = 4
        memory    = 7.GB
        time      = 10.h
    }

    withName: 'CRAM_QC' {
        container = 'basejumper_minibwa-rustqc_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 16
        memory    = 60.GB
        time      = 8.h
    }

    withName: 'PICARD_COLLECTHSMETRICS' {
        container = "quay.io/biocontainers/picard:3.0.0--hdfd78af_0"
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 4
        memory    = 8.GB
        time      = 5.h
    }

    withName: 'GCBIAS_INDEX' {
        container = 'basejumper_bskryb-rustqc-x86_0.1.5'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 2
        memory    = 6.GB
        time      = 1.h
    }


    withName: 'WGSQC_METRICS_TO_PARQUET' {
        container = 'basejumper_custom_parabricks-metrics_1.0.3'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 2
        memory    = 6.GB
        time      = 30.m
    }

    withName: 'AGGREGATE_WGSQC_OUTPUTS' {
        container = 'basejumper_custom_parabricks-metrics_1.0.3'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus      = 2
        memory    = 6.GB
        time      = 30.m
    }

    withName: 'WGS_QC_PLOTS' {
        container      = 'basejumper_custom_r_qcplots_0.3.0'
        cpus           = 2
        memory         = '7 GB'
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries     = 2
        time           = 1.h
    }

    withName: 'MULTIQC' {
        container      = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
        cpus           = 2
        memory         = '7 GB'
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries     = 2
        time           = 5.h
    }
}

// ============================================================================
// LOAD REPORTING CONFIGURATION
// ============================================================================
includeConfig './conf/reporting.config'
