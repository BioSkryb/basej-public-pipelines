            reference                     = "${params.genomes_base}/genomes/Mus_musculus/NCBI/GRCm38/Sequence/BWAIndex"
            base_metrics_intervals        = "${params.genomes_base}/genomes/Mus_musculus/NCBI/GRCm38/Annotation/Intervals/wgs_intervals.bed"
            dbsnp                         = "${params.genomes_base}/genomes/Dummy/Dummy_dbsnp.txt"
