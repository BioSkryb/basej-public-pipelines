            wgs_or_target_intervals       = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/Intervals/wgs_calling_regions_GRCh37_igenomes.v1.interval_list"
            calling_intervals_filename    = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/Intervals/wgs_calling_regions_GRCh37_igenomes.v1.interval_list"
            snpeff_db                     = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Annotation/SnpEff/data"
            snpeff_genome_name            = "GRCh37.87"
            kraken2_db                    = "${params.genomes_base}/dev-resources/minikraken2_v2_8GB_201904_UPDATE"
            dbNSFP_db                     = ""
            dbNSFP_idx                    = ""
            dnascope_model                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DNAScope/Illumina/SentieonDNAscopeModel1.1.model"
            vcfeval_baseline_vcf          = ""
            vcfeval_baseline_vcf_tbi      = ""
            vcfeval_baseline_regions      = ""
            vcfeval_reference_sdf_ref     = ""
            roi_intervals                 = ""
            refseq                        = ""
            species_name                  = "human"
            // TMB specific params
            design_file                   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Annotation/TMB/hg19/ExampleWESdesign.bed"
            tmb_genome                    = "hg19"
            //

            'exome' {
                dnascope_model                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DNAScope/Illumina/DNAscopeIlluminaWES2.0.bundle"
            }

            'wgs' {
                dnascope_model                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DNAScope/Illumina/DNAscopeIlluminaWGS2.0.bundle"
            }
            
            //RNA
            star_index              = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Sequence/STAR_Reference_GRCh37.p13.gencode.v19/index_ensemble/"
            salmon_index            = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Sequence/Salmon_Reference_GRCh37.p13.gencode.v19/index/"
            tx2gene                 = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Sequence/STAR_Reference_GRCh37.p13.gencode.v19/gencode.v19.pc_lncRNA.complete.tx2gene"
            gtf_file                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Sequence/STAR_Reference_GRCh37.p13.gencode.v19/gencode.v19.chr_patch_hapl_scaff.annotation.gtf"
            bed_files_dir           = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh37/Sequence/dummy_bed_files"

