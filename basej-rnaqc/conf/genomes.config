            mills_index                   = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/GATK_bundle/Mills_and_1000G_gold_standard_indels/Mills_and_1000G_gold_standard.indels.vcf.gz.tbi"
            onekg                         = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/GATK_bundle/1000G_phase1/1000G_phase1.snps.high_confidence.vcf.gz"
