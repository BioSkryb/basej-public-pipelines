            hapmap                        = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/GATK_bundle/hapmap_3.3/hapmap.vcf.gz"
            hapmap_index                  = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/GATK_bundle/hapmap_3.3/hapmap.vcf.gz.tbi"
            onekg_omni                    = "${params.genomes_base}/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/GATK_bundle/1000G_omni2.5/1000G_omni.vcf.gz"
