        // ====================================================================
        // T2T-CHM13v2.0 — telomere-to-telomere human assembly (UCSC "hs1")
        // ====================================================================
        // Source: https://hgdownload.soe.ucsc.edu/goldenPath/hs1/bigZips/hs1.fa.gz
        // 25 sequences: chr1-22, chrX, chrY, chrM. 3,117,292,070 bp. No ALT/decoy/
        // unplaced contigs, and essentially no assembly gaps.
        //
        // v2.0 (NOT v1.1) is required: CHM13 is a complete hydatidiform mole and is
        // 46,XX, so v1.1 has NO chrY. v2.0 adds the HG002 chrY. Aligning Y-bearing
        // material to a Y-less reference forces those reads onto chrX and other
        // homologous regions, so v1.1 must not be used for male/sperm samples.
        //
        // SCOPE: this entry deliberately carries ONLY the assembly + coverage
        // intervals. Every other GRCh38 resource here (dbSNP, ClinVar, GIAB truth
        // sets, SnpEff, Ginkgo, blacklists, DNAscope models, ExpansionHunter
        // catalogs) is in GRCh38 coordinates and is NOT valid on T2T without an
        // explicit liftover. Do not copy those keys across — add them only once a
        // genuine T2T-coordinate version exists.
        'T2T-CHM13v2.0' {

            reference                     = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Sequence"
            reference_fasta_name          = "genome.fa"
            // Whole-genome coverage intervals (chr1-22,X,Y — chrM excluded so it does
            // not distort mean depth).
            base_metrics_intervals        = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Intervals/wgs_intervals.bed"
            wgs_or_target_intervals       = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Intervals/wgs_intervals.bed"
            // wgs_intervals MINUS the censat satellite/rDNA mask: 2.877 Gb of 3.117 Gb
            // (92.3%). Needed because whole-chromosome mean depth is badly diluted on
            // chrY, which is 65% satellite in T2T (only 21.8 of 62.5 Mb mappable) vs
            // 2.5% for chrX. Using this for coverage makes the chrX/chrY ratio a valid
            // sex signal instead of one biased ~2.9x against chrY.
            mappable_intervals            = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Intervals/mappable_regions.bed"
            // Non-N bases across chr1-22,X,Y. T2T is gapless, so this is very close
            // to the summed contig length (contrast GRCh38's ~2.92 Gb territory).
            genome_territory              = 3117275501
            species_name                  = "human"

            'pacbio' {
                reference            = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Sequence"
                reference_fasta_name = "genome.fa"
                // No DeepVariant PacBio model is published for T2T coordinates; the
                // GRCh38 model is not transferable. Left unset on purpose.
            }

            // ---- Ginkgo CNV background (FIXED bins, long-read safe) ----
            // Fixed bins are read-length independent, so they are valid for ~3 kb HiFi
            // reads. Variable bins are NOT available for long reads: the builder makes
            // them with simReads -> `bwa aln`, a short-read aligner that cannot handle
            // kb-scale reads. See the reference README for the full rationale.
            //
            // censat_mask_bed / ginkgo_exclude_bins replace the builder's
            // ComputeCentromeres step, which detects N-RUNS (verified) and therefore
            // finds nothing on T2T — this assembly has zero N bases.
            ginkgo_bin_type   = "fixed"
            censat_mask_bed   = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/censat_mask.bed"
            '500000' {
                ginko_ref_dir        = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/"
                ginkgo_exclude_bins  = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/exclude_bins_fixed_500000"
            }
            '1000000' {
                ginko_ref_dir        = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/"
                ginkgo_exclude_bins  = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/exclude_bins_fixed_1000000"
            }
            '2000000' {
                ginko_ref_dir        = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/"
                ginkgo_exclude_bins  = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/exclude_bins_fixed_2000000"
            }
            '5000000' {
                ginko_ref_dir        = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/"
                ginkgo_exclude_bins  = "${params.genomes_base}/genomes/Homo_sapiens/T2T/CHM13v2.0/Annotation/Ginkgo_reference/T2T_CHM13v2.0_FIXED_LongRead/exclude_bins_fixed_5000000"
            }
        }
        
        'GRCh37' {
            
