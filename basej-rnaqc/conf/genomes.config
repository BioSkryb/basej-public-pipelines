/*
========================================================================================
    Nextflow config file for genomes paths
========================================================================================
    Defines reference genomes using iGenome paths.
    Can be used by any config that customises the base path using:
        $params.genomes_base / --genomes_base
----------------------------------------------------------------------------------------
*/

params {
    genomes_base = "s3://bioskryb-shared-data"
    genomes {

        // ------------------------------------------------------------------
        // 1000 Genomes GRCh38 analysis set (GRCh38_full_analysis_set_plus_decoy_hla.fa).
        // Same coordinate system as the GATK-bundle 'GRCh38' below for chr1-22/X/Y/M,
        // but a different contig set (decoy + HLA, no ALTs) => its own sequence
        // dictionary, so it gets its own reference tree and interval files.
        //
        // Scope: ALIGNMENT + QC only (basej-wgs / basej-dnaqc). Build the bundle
        // (reference FASTA, BWA-MEM2 index, and interval files) and upload it to S3 before use.
        // Variant-calling resources (dbsnp/mills/1000G/hapmap/calling intervals/
        // vcfeval SDF) are intentionally omitted until they are lifted/validated
        // against this reference's dictionary — see the commented block below.
        // ------------------------------------------------------------------
        'GRCh38_decoy_hla' {

            reference                     = "${params.genomes_base}/genomes/Homo_sapiens/1000G/GRCh38_decoy_hla/Sequence"
            bwamem2_reference             = "${params.genomes_base}/genomes/Homo_sapiens/1000G/GRCh38_decoy_hla/Sequence_bwamem2"
            base_metrics_intervals        = "${params.genomes_base}/genomes/Homo_sapiens/1000G/GRCh38_decoy_hla/Annotation/Intervals/wgs_intervals.bed"
            wgs_or_target_intervals       = "${params.genomes_base}/genomes/Homo_sapiens/1000G/GRCh38_decoy_hla/Annotation/Intervals/wgs_coverage_regions.interval_list"
            species_name                  = "human"

            // --- Variant-calling resources (NOT YET BUILT for this reference) ---
            // Uncomment and point at lifted/validated files once they exist. Do
            // not copy the GATK-bundle GRCh38 paths verbatim: their .interval_list
            // and .dict-keyed files are keyed to a different contig set.
            // dbsnp                      = "..."
            // dbsnp_index                = "..."
            // mills                      = "..."
            // mills_index                = "..."
            // onekg                      = "..."
            // onekg_index                = "..."
            // hapmap                     = "..."
            // hapmap_index               = "..."
            // calling_intervals_filename = "..."
            // vcfeval_reference_sdf_ref  = "..."
        }

        'GRCh38' {
            
            reference                     = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence"
            bwamem2_reference             = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence_bwamem2"
            rna_reference                 = "${params.genomes_base}/genomes/Homo_sapiens/RNAseq_Ensembl_104/Sequence/"
            base_metrics_intervals        = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Intervals/wgs_intervals.bed"
            minibwa_index                 = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence/minibwa/genome"
            gc_windows_base_metrics       = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/gcbias_windows/gcwin_basemetrics_w100.txt"
            gc_windows_wgs                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/gcbias_windows/gcwin_wgscov_w100.txt"
            dbsnp                         = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/dbsnp_138/dbsnp.vcf.gz"
            dbsnp_index                   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/dbsnp_138/dbsnp.vcf.gz.tbi"
            clinvar                       = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Clinvar/20220214/clinvar.vcf.gz"
            clinvar_index                 = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Clinvar/20220214/clinvar.vcf.gz.tbi"
            mills                         = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Mills_and_1000G_gold_standard_indels/Mills_and_1000G_gold_standard.indels.vcf.gz"
            mills_index                   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Mills_and_1000G_gold_standard_indels/Mills_and_1000G_gold_standard.indels.vcf.gz.tbi"
            onekg                         = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/1000G_phase1/1000G_phase1.snps.high_confidence.vcf.gz"
            onekg_index                   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/1000G_phase1/1000G_phase1.snps.high_confidence.vcf.gz.tbi"
            hapmap                        = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/hapmap_3.3/hapmap.vcf.gz"
            hapmap_index                  = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/hapmap_3.3/hapmap.vcf.gz.tbi"
            onekg_omni                    = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/1000G_omni2.5/1000G_omni.vcf.gz"
            onekg_omni_index              = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/1000G_omni2.5/1000G_omni.vcf.gz.tbi"
            wgs_or_target_intervals       = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/wgs_coverage_regions.interval_list"
            calling_intervals_filename    = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/wgs_calling_regions_incl_chrM.interval_list"
            snpeff_db                     = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/SnpEff/data"
            snpeff_genome_name            = "GRCh38.99"
            kraken2_db                    = "${params.genomes_base}/dev-resources/minikraken2_v2_8GB_201904_UPDATE"
            dbnsfp                        = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/dbNSFP4.2c/resources/dbNSFP4.2c_chr.txt.gz"
            dbnsfp_index                  = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/dbNSFP4.2c/resources/dbNSFP4.2c_chr.txt.gz.tbi"
            dnascope_model                = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DNAScope/Illumina/SentieonDNAscopeModel1.1.model"
            vcfeval_reference_sdf_ref     = "${params.genomes_base}/genomes/Homo_sapiens/rtg_human_SDF/"
            roi_intervals                 = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Intervals/Exome_panels/IDT/IDT.Exomev2.targets.hg38.interval_list"
            variant_annotation_genic_intervals = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Intervals/Exome_panels/IDT/IDT.Exomev2.targets.hg38.bed"
            refseq                        = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Genes/ncbiRefSeq.txt"
            species_name                  = "human"
            genic_intervals               = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Intervals/Exome_panels/IDT/IDT.Exomev2.targets.hg38.bed"
            // TMB specific params
            design_file                   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/TMB/hg38/ExampleWESdesign.bed"
            tmb_genome                    = "hg38"
            cytosine_bed       = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/basej-methylqc/GRCh38_cytosine_sites.bed"
            cytosine_annotation = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/basej-methylqc/GRCh38_cytosine_annotation.tsv"
            cytosine_bed_5m    = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/basej-methylqc/GRCh38_cytosine_sites_sampled_5M.bed"
            cytosine_annotation_5m = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/basej-methylqc/GRCh38_cytosine_annotation_sampled_5M.tsv"
            confound_mask_bed  = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/basej-methylqc/giab_ct_ga_mask.bed"

            // Truth-anchored CpG probe panels for basej-methylqc. Each carries a truth_state
            // per site (methylated / unmethylated), which is what makes a real signal-to-noise
            // ratio computable: T-rate at known-methylated over T-rate at known-unmethylated.
            // The existing cytosine_bed* panels above are unchanged and keep their columns.
            // Built by analysis/260818_methylqc_deepseq_selection/scripts/20_build_cpg_panels.py;
            // see each manifest.json for accessions, funnel counts and checksums.
            'cpg_panels' {
                // ENCODE cross-tissue invariant anchors, 1,517,371 sites
                // (529,406 methylated / 987,965 unmethylated) from 18 WGBS biosamples,
                // none of them HG002. Masked for blacklist / low-mappability / C>T-G>A and
                // imprinted regions - the C>T mask matters because a C>T SNP is
                // indistinguishable from a converted methylated C.
                'encode_truth_v1' {
                    sites      = "${params.genomes_base}/datasets/methylqc_cpg_panels/encode_truth_v1/sites.bed"
                    annotation = "${params.genomes_base}/datasets/methylqc_cpg_panels/encode_truth_v1/annotation.tsv"
                }
                // HG002 ONT high-confidence truth, 5,945,722 sites
                // (4,397,789 methylated / 1,547,933 unmethylated). This is the already-selected
                // and reported panel, read verbatim from
                // analysis/260727_ont_sc_detection_genomewide/clean_panel_ALL3.parquet - it was
                // NOT re-derived, because the published definition could not be reproduced from
                // the raw ONT calls in this repo. Already confounder-filtered at source (GIAB
                // C>T/G>A, ENCODE blacklist v2, low-mappability) and includes chrX/chrY.
                'hg002_truth_v1' {
                    sites      = "${params.genomes_base}/datasets/methylqc_cpg_panels/hg002_truth_v1/sites.bed"
                    annotation = "${params.genomes_base}/datasets/methylqc_cpg_panels/hg002_truth_v1/annotation.tsv"
                }
            }

            // Cell-identity reference for basej-methylqc CELL_IDENTITY. Separate from cpg_panels
            // above because it is not a probe panel: it is the ENCODE atlas itself, 18 biosample
            // methylomes reduced to per-window mean beta, plus the CpG ordering that defines those
            // windows. Windows are CpG-RANK based (rank // window_size), NOT genomic coordinates,
            // so cpg_rank.parquet is mandatory — a window cannot be recomputed without that exact
            // ordering. Built by
            // analysis/260818_methylqc_deepseq_selection/scripts/22_build_identity_reference.py
            // from analysis/sc5mc caches; see manifest.json for checksums and constants.
            'cell_identity' {
                atlas_profiles   = "${params.genomes_base}/datasets/methylqc_cell_identity/v1/atlas_profiles.npz"
                cpg_rank         = "${params.genomes_base}/datasets/methylqc_cell_identity/v1/cpg_rank.parquet"
                variable_windows = "${params.genomes_base}/datasets/methylqc_cell_identity/v1/variable_windows.npz"
            }

            // ---------------------------------------------------------------
            // BioSkryb-trained DeepVariant models. Selected in
            // basej-google-deepvariant with --deepvariant_model_type <name>.
            //
            // Each block is self-describing: `model`, `population_vcfs` and
            // `channel_list` are all read from here, so adding a future model
            // means adding a block below and nothing else.
            //
            // The channel set MUST match the model's own example_info.json or
            // call_variants dies on a tensor-shape mismatch. That match is made
            // for us: make_examples is always invoked with --checkpoint, and in
            // calling mode DeepVariant reads example_info.json from the
            // checkpoint directory and derives the channel set from it. See
            // make_examples_options.py in google/deepvariant r1.8 — the
            // --channel_list flag is only consulted in the `elif` branch, i.e.
            // when the checkpoint supplied no channels. So `channel_list` below
            // is DOCUMENTATION of what the checkpoint declares, not control:
            // changing it does not change what make_examples builds. Keep it in
            // step with example_info.json anyway, so the config does not lie
            // about the model.
            //
            // Verified against the checkpoints in S3 (2026-09-05):
            //   bioskrybv1       DV 1.7.0  shape [100,221,8]   channels 1-6,19,8
            //   bioskrybv2       DV 1.8.0  shape [100,221,10]  channels 1-6,8,13,19
            //   resolvemethylv1  DV 1.8.0  shape [100,221,9]   channels 1-6,8,13,19
            // (8 = allele_frequency, 13 = identity, 19 = insert_size)
            // bioskrybv2's declared shape (10) does not agree with its own
            // channel count (9); resolvemethylv1's does. Recorded as observed —
            // DeepVariant reads shape and channels from the same file, so the
            // pipeline is unaffected either way.
            // ---------------------------------------------------------------
            'bioskrybv1' {
                model = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-af-20241102/model"
                population_vcfs = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-af-20241102/population_vcfs"
                // This model's channel ORDER is non-canonical (insert_size
                // before allele_frequency), so it cannot be written as a
                // BASE_CHANNELS-prefixed list. Left empty rather than recording
                // a list that would misdescribe the checkpoint.
                channel_list = ""
            }
            // bioskrybv2 = ResolveOME ("rome") DeepVariant 1.8.0 model. Adds the
            // `identity` channel (ch13) on top of bioskrybv1's set, in ascending
            // channel order. Reuses the bioskrybv1 population_vcfs (the
            // allele_frequency channel), which is what it was trained against.
            'bioskrybv2' {
                model = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-rome-v2-1-1-20250625/model"
                population_vcfs = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-af-20241102/population_vcfs"
                channel_list = "BASE_CHANNELS,allele_frequency,identity,insert_size"
            }
            // resolvemethylv1 = ResolveMethyl DeepVariant 1.8.0 model. Declares
            // the same channel set as bioskrybv2 (1-6,8,13,19) but is a separate,
            // larger checkpoint (261 MB of weights vs 87 MB). Reuses the
            // bioskrybv1 population_vcfs, which is what it was trained against
            // and what the validating run below used.
            //
            // First exercised on Seqera run 4SfrE158i5jfMz (BioSkryb /
            // Development, 2026-04-13, SUCCEEDED, 3 biosamples through all three
            // DV stages), which reached this checkpoint by overriding
            // --deepvariant_model by hand. This block is that override made
            // first-class, so it can be selected with
            // --deepvariant_model_type resolvemethylv1 instead.
            'resolvemethylv1' {
                model = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-methyl-af-20260413/model"
                population_vcfs = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/Illumina/bioskryb-af-20241102/population_vcfs"
                channel_list = "BASE_CHANNELS,allele_frequency,identity,insert_size"
            }
            'efficient_dv' {
                ref_fasta       = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence/genome.fa"
                ref_fasta_index = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence/genome.fa.fai"
                ref_dict        = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/GATK_bundle/Sequence/genome.dict"
                model_onnx      = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Ultima/EfficientDV/model.onnx"
                // Ultima Efficient DV post-process exome overlay (Twist); includes ##INFO so ug_postproc does not need a .bed.json sidecar. source s3://ultimagen-workflow-resources-us-east-1/hg38/annotation_intervals/exome.twist.bed
                exome_intervals = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/Ultima/EfficientDV/exome.twist.bed"
            }
            'pacbio' {
                model = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/DeepVariant/PacBio/1.8.0/model"
                // PacBio-recommended GRCh38 reference (no-ALT analysis set). Kept separate
                // from the GATK bundle above because the FASTA is named differently and
                // pbmm2/HiFi tooling is validated against this exact assembly.
                reference           = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/PacBio_bundle/no_alt_analyses_set/sequence"
                reference_fasta_name = "human_GRCh38_no_alt_analysis_set.fasta"
            }

            // SigProfile
            sigprofilermatrixgenerator_reference   = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/SigProfilerMatrixGenerator/tsb"
            sigprofilermatrixgenerator_interval    = "${params.genomes_base}/genomes/Homo_sapiens/NCBI/GRCh38/Annotation/SigProfilerMatrixGenerator/dummy_file.txt" // Optinal in BED formatl

            
            'HG001' {
                giab_genome_name              = "HG001"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG001_GRCh38_1_22_v4.2.1_benchmark.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG001_GRCh38_1_22_v4.2.1_wgs_bedregions_eval.bed"
            }
            
            'HG002' {
                giab_genome_name              = "HG002"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent_wgs_bedregions_eval.bed"
            }
  
            'HG002-T2T' {
                giab_genome_name              = "HG002"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_T2TQ100_v1.1/GRCh38_HG2-T2TQ100-V1.1.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_T2TQ100_v1.1/GRCh38_HG2-T2TQ100-V1.1.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_T2TQ100_v1.1/GRCh38_HG2-T2TQ100-V1.1_smvar.benchmark.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_T2TQ100_v1.1/GRCh38_HG2-T2TQ100-V1.1_smvar.benchmark_wgs_bedregions_eval.bed"

            }
            
            
            'HG003' {
                giab_genome_name              = "HG003"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG003_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG003_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG003_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG003_GRCh38_1_22_v4.2.1_benchmark_noinconsistent_wgs_bedregions_eval.bed"
            
            }
            
            
            'HG004' {
                giab_genome_name              = "HG004"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG004_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG004_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG004_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG004_GRCh38_1_22_v4.2.1_benchmark_noinconsistent_wgs_bedregions_eval.bed"
            
            }
            
            'HG005' {
                giab_genome_name              = "HG005"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG005_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG005_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG005_GRCh38_1_22_v4.2.1_benchmark.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG005_GRCh38_1_22_v4.2.1_benchmark_wgs_bedregions_eval.bed"
            
            }
            
            'HG006' {
                giab_genome_name              = "HG006"
                vcfeval_baseline_vcf          = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG006_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
                vcfeval_baseline_vcf_index    = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG006_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi"
                vcfeval_baseline_regions      = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG006_GRCh38_1_22_v4.2.1_benchmark.bed"
                vcfeval_bed_regions           = "${params.genomes_base}/genomes/Homo_sapiens/GIAB/GRCh38_v4.2.1/HG006_GRCh38_1_22_v4.2.1_benchmark_wgs_bedregions_eval.bed"
            
            }
            
            
            'HG007' {
